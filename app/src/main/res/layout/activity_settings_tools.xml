<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/section_tools"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/toolsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/app_screen_padding">

            <com.google.android.material.card.MaterialCardView
                style="@style/App_Card_Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/App_CardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_tools_master" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_tools_enable_dashboard" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tools_enable_dashboard_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_tools_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_tools_dedicated_folder" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tools_dedicated_folder_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_dashboard_all_pages" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/feature_dashboard_all_pages_label" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/feature_dashboard_all_pages_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/feature_dashboard_extra_label" android:textColor="?attr/colorOnSurface" />
                    <TextView android:id="@+id/tv_dashboard_extra_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
                    <Button android:id="@+id/btn_dashboard_extra" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/feature_dashboard_extra_choose" android:textSize="12sp" />

                    <View android:id="@+id/divTools" android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginVertical="16dp" />

                    <LinearLayout
                        android:id="@+id/layoutToolsSubOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tools_dashboard_items" android:textColor="?attr/colorOnSurface" android:textStyle="bold" />
                        
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_sys_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_tools_system_info_overlay" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tools_system_info_overlay_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_power_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/action_power_menu" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tools_power_menu_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_volume_keys" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_tools_volume_controls" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tools_volume_controls_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_brightness_keys" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_tools_brightness_controls" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tools_brightness_controls_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_screenshot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_tools_screenshot_button" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tools_screenshot_button_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginVertical="20dp" />

                        <!-- Shizuku Section -->
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tools_service_integration" android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:visibility="gone" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardShizuku"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            android:visibility="gone"
                            app:strokeWidth="1dp"
                            app:strokeColor="?attr/colorOutlineVariant">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ui_tools_shizuku_service"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:textColor="?attr/colorPrimary" />
                                <TextView
                                    android:id="@+id/tvShizukuStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/ui_tools_not_connected"
                                    android:textSize="11sp" />
                                <Button
                                    android:id="@+id/btnLinkShizuku"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/ui_tools_link_shizuku"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Edge panel pages: apps / contacts / tools -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App_Card_Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    style="@style/App_CardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_edge_pages" android:textColor="?attr/colorOnSurface" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/feature_pages_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_thumb_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/feature_thumb_mode_label" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/feature_thumb_mode_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/feature_page_apps_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_contacts_page" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/feature_contacts_page_label" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/feature_contacts_page_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_tools_page" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/feature_tools_page_label" android:textColor="?attr/colorOnSurface" />
                    <TextView android:id="@+id/tv_tools_page_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
                    <Button android:id="@+id/btn_tools_page_items" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/feature_tools_page_choose" android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Edge Features: Clipboard, Contacts, Extra Dim -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App_Card_Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    style="@style/App_CardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_edge_features" android:textColor="?attr/colorOnSurface" android:textStyle="bold" />

                    <!-- Clipboard -->
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_clipboard_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/feature_clipboard_label" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/feature_clipboard_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/layout_clipboard_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/feature_clipboard_hint" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
                        <Button android:id="@+id/btn_clipboard_background" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/feature_clipboard_background" android:textSize="12sp" />
                    </LinearLayout>
                    <Button android:id="@+id/btn_clipboard_clear" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/feature_clipboard_clear_all" android:textSize="12sp" />

                    <!-- Saved texts (IBAN, phone number, ...) -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/feature_snippets_label" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/feature_snippets_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
                    <LinearLayout
                        android:id="@+id/layout_snippets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />
                    <Button android:id="@+id/btn_snippet_add" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/feature_snippets_add" android:textSize="12sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginVertical="16dp" />

                    <!-- Favorite contacts -->
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_contacts_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/feature_contacts_label" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/feature_contacts_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_direct_call" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/feature_direct_call_label" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/feature_direct_call_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <Button android:id="@+id/btn_contacts_add" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/feature_contacts_add" android:textSize="12sp" />
                        <Button android:id="@+id/btn_contacts_import" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="@string/feature_contacts_import" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_favorite_contacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginVertical="16dp" />

                    <!-- Extra Dim -->
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/feature_extra_dim_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/feature_extra_dim_label" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/feature_extra_dim_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_extra_dim_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="?attr/colorPrimary" android:textSize="11sp" />
                    <Button android:id="@+id/btn_extra_dim_grant" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/feature_extra_dim_grant" android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
